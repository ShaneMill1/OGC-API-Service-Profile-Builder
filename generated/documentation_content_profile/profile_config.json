  "requirements": [
    {
      "id": "temperature-geojson",
      "title": "Temperature GeoJSON response",
      "description": [
        {
          "format": "markdown",
          "body": "Clients need a predictable encoding for temperature observations.\n\n![Metadata discovery workflow](metadata-discovery-workflow.png)\n\nThe response is a GeoJSON `FeatureCollection`. Each feature carries:\n\n* `geometry` - the observation point\n* `properties.temp` - the temperature in degrees Celsius\n",
          "title": null,
          "id": null
        },
        {
          "format": "plantuml",
          "body": "Client -> Service: GET /collections/temperature/items\nService --> Client: 200 application/geo+json (FeatureCollection)\n",
          "title": "Request/response flow for the items endpoint",
          "id": "fig-items-flow"
        },
        {
          "format": "preformatted",
          "body": "FeatureCollection\n+-- features[]\n    +-- geometry   Point [lon, lat]\n    +-- properties\n        +-- temp   number (degC)\n",
          "title": "Shape of a response feature",
          "id": null
        }
      ],
      "description_position": "before",
      "parts": [
        "The temperature collection SHALL return GeoJSON features.",
        "The service SHALL provide a /collections/temperature/items endpoint.",
        "The response Content-Type SHALL be application/geo+json."
      ],
      "statement": null,
      "level": "requirement",
      "conformance_class": null
    },
    {
      "id": "temperature-units-label",
      "title": "Temperature unit label",
      "description": "NOTE: A consistent unit label lets clients show temperatures without guessing the unit.",
      "description_position": "after",
      "parts": [
        "The temperature collection SHOULD label its unit as Celsius.",
        "Each temp parameter SHOULD expose a unit.label of \"Celsius\"."
      ],
      "statement": null,
      "level": "recommendation",
      "conformance_class": null
    },
    {
      "id": "temperature-post-query",
      "title": "POST queries",
      "description": "Some clients send queries that are too long for a URL.",
      "description_position": "before",
      "parts": [
        "The service MAY support POST queries for the temperature collection.",
        "Implementations MAY offer POST alongside GET on data query endpoints."
      ],
      "statement": null,
      "level": "permission",
      "conformance_class": null
    }
  ],
