  "collection_examples": {},
  "requirements": [
    {
      "id": "conformance",
      "statement": "The service SHALL declare conformance to OGC API EDR Core and the MetOcean EDR Profile.",
      "parts": [
        "The /conformance endpoint SHALL include http://www.opengis.net/spec/ogcapi-edr-1/1.0/conf/core.",
        "The /conformance endpoint SHALL include https://eumetnet.github.io/spec/metocean-edr-profile/1/conf/core.",
        "The /conformance endpoint SHALL include https://eumetnet.github.io/spec/metocean-edr-profile/1/conf/insitu-observations."
      ],
      "conformance_class": null
    },
    {
      "id": "collections-endpoint",
      "statement": "The service SHALL provide a /collections endpoint listing the insitu-observations collection.",
      "parts": [
        "The /collections endpoint SHALL return the insitu-observations collection.",
        "Each collection SHALL include extent, data_queries, output_formats, and parameter_names."
      ],
      "conformance_class": null
    },
    {
      "id": "collection-crs",
      "statement": "The insitu-observations collection SHALL support OGC CRS84 as its primary CRS.",
      "parts": [
        "The extent.spatial.crs SHALL be http://www.opengis.net/def/crs/OGC/1.3/CRS84.",
        "The crs array SHALL include http://www.opengis.net/def/crs/OGC/1.3/CRS84."
      ],
      "conformance_class": null
    },
    {
      "id": "collection-temporal-extent",
      "statement": "The insitu-observations collection SHALL declare a temporal extent using the Gregorian TRS.",
      "parts": [
        "The extent.temporal.trs SHALL be Gregorian.",
        "The extent.temporal.interval SHALL contain at least one valid ISO 8601 interval."
      ],
      "conformance_class": null
    },
    {
      "id": "collection-custom-dimensions",
      "statement": "The insitu-observations collection SHALL define standard_name and level custom dimensions.",
      "parts": [
        "extent.custom SHALL contain an object with id standard_name and reference https://vocab.nerc.ac.uk/standard_name/.",
        "extent.custom SHALL contain an object with id level and reference describing measurement height in meters."
      ],
      "conformance_class": null
    },
    {
      "id": "data-queries",
      "statement": "The insitu-observations collection SHALL support locations, area, and radius data queries.",
      "parts": [
        "The collection SHALL provide a /collections/insitu-observations/locations endpoint.",
        "The collection SHALL provide a /collections/insitu-observations/area endpoint.",
        "The collection SHALL provide a /collections/insitu-observations/radius endpoint.",
        "The radius query variables SHALL include within_units containing at least m."
      ],
      "conformance_class": null
    },
    {
      "id": "output-formats",
      "statement": "All data queries SHALL support CoverageJSON as a response format.",
      "parts": [
        "All data queries SHALL support application/vnd.cov+json.",
        "The locations query SHALL additionally support application/geo+json."
      ],
      "conformance_class": null
    },
    {
      "id": "parameter-names",
      "statement": "Each parameter in parameter_names SHALL conform to the MetOcean EDR Profile parameter conventions.",
      "parts": [
        "Each parameter SHALL specify label, description, unit, observedProperty, and measurementType.",
        "unit.symbol.type SHALL be a QUDT unit URI of the form https://qudt.org/vocab/unit/<unit>.",
        "observedProperty.id SHALL be a CF standard name URI of the form https://vocab.nerc.ac.uk/standard_name/<name>.",
        "Each parameter SHALL specify metocean:standard_name matching a value in extent.custom standard_name.",
        "Each parameter SHALL specify metocean:level matching a value in extent.custom level."
      ],
      "conformance_class": null
    },
    {
      "id": "locations-response",
      "statement": "The locations query SHALL return a GeoJSON FeatureCollection of station locations.",
      "parts": [
        "The response Content-Type SHALL be application/geo+json.",
        "Each feature SHALL have an id property of type string.",
        "Each feature SHALL have a properties.name property of type string."
      ],
      "conformance_class": null
    },
    {
      "id": "error-handling",
      "statement": "The service SHALL handle errors per RFC 9457.",
      "parts": [
        "A 4xx response SHALL include a body conforming to RFC 9457 Problem Details.",
        "A query for data inside the extent that returns no data SHALL respond with HTTP 204."
      ],
      "conformance_class": null
    }
  ],
  "abstract_tests": [
    {
      "id": "conformance",
      "requirement_id": "conformance",
      "steps": [
        "Send GET request to /conformance.",
        "Verify HTTP status is 200.",
        "Verify conformsTo includes http://www.opengis.net/spec/ogcapi-edr-1/1.0/conf/core.",
        "Verify conformsTo includes https://eumetnet.github.io/spec/metocean-edr-profile/1/conf/core.",
        "Verify conformsTo includes https://eumetnet.github.io/spec/metocean-edr-profile/1/conf/insitu-observations."
      ]
    },
    {
      "id": "collections-endpoint",
      "requirement_id": "collections-endpoint",
      "steps": [
        "Send GET request to /collections.",
        "Verify HTTP status is 200.",
        "Verify the collections array contains an object with id insitu-observations.",
        "Verify the collection includes extent, data_queries, output_formats, and parameter_names."
      ]
    },
    {
      "id": "collection-crs",
      "requirement_id": "collection-crs",
      "steps": [
        "Send GET request to /collections/insitu-observations.",
        "Verify extent.spatial.crs equals http://www.opengis.net/def/crs/OGC/1.3/CRS84.",
        "Verify the crs array includes http://www.opengis.net/def/crs/OGC/1.3/CRS84."
      ]
    },
    {
      "id": "collection-temporal-extent",
      "requirement_id": "collection-temporal-extent",
      "steps": [
        "Send GET request to /collections/insitu-observations.",
        "Verify extent.temporal.trs equals Gregorian.",
        "Verify extent.temporal.interval contains at least one two-element array."
      ]
    },
    {
      "id": "collection-custom-dimensions",
      "requirement_id": "collection-custom-dimensions",
      "steps": [
        "Send GET request to /collections/insitu-observations.",
        "Verify extent.custom contains an object with id standard_name.",
        "Verify that object has reference https://vocab.nerc.ac.uk/standard_name/.",
        "Verify extent.custom contains an object with id level."
      ]
    },
    {
      "id": "data-queries",
      "requirement_id": "data-queries",
      "steps": [
        "Send GET request to /collections/insitu-observations.",
        "Verify data_queries contains locations, area, and radius.",
        "Verify the radius variables.within_units array contains m."
      ]
    },
    {
      "id": "output-formats",
      "requirement_id": "output-formats",
      "steps": [
        "Send GET request to /collections/insitu-observations/area with a valid polygon.",
        "Verify HTTP status is 200.",
        "Verify Content-Type is application/vnd.cov+json.",
        "Send GET request to /collections/insitu-observations/locations.",
        "Verify Content-Type is application/geo+json."
      ]
    },
    {
      "id": "parameter-names",
      "requirement_id": "parameter-names",
      "steps": [
        "Send GET request to /collections/insitu-observations.",
        "For each parameter in parameter_names, verify label, description, unit, observedProperty, and measurementType are present.",
        "Verify unit.symbol.type starts with https://qudt.org/vocab/unit/.",
        "Verify observedProperty.id starts with https://vocab.nerc.ac.uk/standard_name/.",
        "Verify metocean:standard_name is present and matches a value in extent.custom standard_name.values.",
        "Verify metocean:level is present and matches a value in extent.custom level.values."
      ]
    },
    {
      "id": "locations-response",
      "requirement_id": "locations-response",
      "steps": [
        "Send GET request to /collections/insitu-observations/locations.",
        "Verify HTTP status is 200.",
        "Verify Content-Type is application/geo+json.",
        "Verify response type is FeatureCollection.",
        "Verify each feature has id and properties.name."
      ]
    },
    {
      "id": "error-handling",
      "requirement_id": "error-handling",
      "steps": [
        "Send GET request to /collections/nonexistent-collection.",
        "Verify HTTP status is 404.",
        "Verify Content-Type is application/problem+json.",
        "Verify response body includes type and title properties."
      ]
    }
  ],
