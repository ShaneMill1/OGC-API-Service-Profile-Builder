  "parameter_schema": {
    "type": "object",
    "title": "Parameter name",
    "description": "Definition of a data parameter in this collection",
    "required": [
      "type",
      "observedProperty",
      "measurementType",
      "label",
      "description",
      "unit",
      "metocean:standard_name",
      "metocean:level"
    ],
    "properties": {
      "type": {
        "type": "string",
        "enum": [
          "Parameter"
        ]
      },
      "label": {
        "type": "string",
        "description": "Human-readable parameter name (max 50 characters, English)"
      },
      "description": {
        "type": "string",
        "description": "Longer description of the parameter"
      },
      "unit": {
        "type": "object",
        "required": [
          "symbol"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "symbol": {
            "type": "object",
            "required": [
              "type",
              "value"
            ],
            "properties": {
              "type": {
                "type": "string",
                "pattern": "^https://qudt\\.org/vocab/unit/.*$"
              },
              "value": {
                "type": "string"
              }
            }
          }
        }
      },
      "observedProperty": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^https://vocab\\.nerc\\.ac\\.uk/standard_name/.*$"
          },
          "label": {
            "type": "string"
          }
        }
      },
      "measurementType": {
        "type": "object",
        "required": [
          "method",
          "duration"
        ],
        "properties": {
          "method": {
            "type": "string"
          },
          "duration": {
            "type": "string",
            "pattern": "^P(\\d+Y)?(\\d+M)?(\\d+D)?(T(\\d+H)?(\\d+M)?(\\d+S)?)?$"
          }
        }
      },
      "metocean:standard_name": {
        "type": "string",
        "description": "CF-convention standard name for the parameter"
