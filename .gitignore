# Transient PDF build error logs (not the stylesheet override, which is a
# tracked part of the generated profile output referenced by document.adoc)
*.pdf.err

# Metanorma build byproducts inside generated/ profile outputs. We commit the
# meaningful artifacts (document.adoc, document.pdf, sections/, requirements/,
# abstract_tests/, openapi.yaml, profile_config.json, and branding assets like
# cover.png / boilerplate.xml / *_override.xsl) but not the build cache/logs.
generated/*/relaton/
generated/**/*.log.txt
generated/*/document.err.html
generated/*/document.presentation.xml
generated/*/document.xml

